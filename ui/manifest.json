{
    "_version": "1.12.0",

    "sap.app": {
        "id": "smartprocure360",
        "type": "application",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "title": "SmartProcure360",
        "description": "Intelligent Procurement & Vendor Risk Management System"
    },

    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },

    "sap.ui5": {

        "rootView": {
            "viewName": "smartprocure360.view.App",
            "type": "XML",
            "async": false,
            "id": "app"
        },

        "dependencies": {
            "minUI5Version": "1.60.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.layout": {}
            }
        },

        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "smartprocure360.i18n.i18n"
                }
            }
        }

    }
}