<mvc:View
    controllerName="smartprocure360.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <App id="app">

        <Page
            title="SmartProcure360 - Procurement &amp; Vendor Risk Dashboard"
            showHeader="true">

            <content>

                <VBox
                    class="sapUiMediumMargin"
                    width="auto">

                    <Title
                        text="SmartProcure360"
                        level="H1"
                        class="sapUiSmallMarginBottom"/>

                    <Text
                        text="Intelligent Procurement &amp; Vendor Risk Management System"
                        class="sapUiSmallMarginBottom"/>

                    <!-- =================================================
                         RISK SUMMARY
                         ================================================= -->

                    <Panel
                        headerText="Risk Summary"
                        class="sapUiMediumMarginBottom">

                        <HBox
                            wrap="Wrap"
                            justifyContent="SpaceBetween">

                            <VBox class="kpiCard">
                                <Text text="Total Vendors"/>
                                <ObjectNumber
                                    number="{dashboard>/totalVendors}"
                                    state="Information"/>
                            </VBox>

                            <VBox class="kpiCard">
                                <Text text="Low Risk"/>
                                <ObjectNumber
                                    number="{dashboard>/lowRisk}"
                                    state="Success"/>
                            </VBox>

                            <VBox class="kpiCard">
                                <Text text="Medium Risk"/>
                                <ObjectNumber
                                    number="{dashboard>/mediumRisk}"
                                    state="Warning"/>
                            </VBox>

                            <VBox class="kpiCard">
                                <Text text="High Risk"/>
                                <ObjectNumber
                                    number="{dashboard>/highRisk}"
                                    state="Error"/>
                            </VBox>

                            <VBox class="kpiCard">
                                <Text text="Critical Risk"/>
                                <ObjectNumber
                                    number="{dashboard>/criticalRisk}"
                                    state="Error"/>
                            </VBox>

                        </HBox>

                    </Panel>


                    <!-- =================================================
                         RISK ANALYTICS
                         ================================================= -->

                    <Panel
                        headerText="Risk Analytics"
                        class="sapUiMediumMarginBottom">

                        <VBox class="sapUiMediumMargin">

                            <HBox
                                alignItems="Center"
                                class="sapUiSmallMarginBottom">

                                <VBox width="220px">

                                    <Text
                                        text="Average Vendor Risk Score"/>

                                    <ObjectNumber
                                        number="{analytics>/averageRiskScore}"
                                        state="Information"/>

                                </VBox>

                                <Text
                                    text="{analytics>/riskStatusText}"
                                    wrapping="true"/>

                            </HBox>


                            <HBox
                                alignItems="Center"
                                class="sapUiSmallMarginBottom">

                                <VBox width="120px">

                                    <Text text="LOW"/>

                                    <Text
                                        text="{dashboard>/lowRisk} vendors"/>

                                </VBox>

                                <ProgressIndicator
                                    width="100%"
                                    percentValue="{analytics>/lowPercentage}"
                                    displayValue="{analytics>/lowPercentage}%"
                                    state="Success"/>

                            </HBox>


                            <HBox
                                alignItems="Center"
                                class="sapUiSmallMarginBottom">

                                <VBox width="120px">

                                    <Text text="MEDIUM"/>

                                    <Text
                                        text="{dashboard>/mediumRisk} vendors"/>

                                </VBox>

                                <ProgressIndicator
                                    width="100%"
                                    percentValue="{analytics>/mediumPercentage}"
                                    displayValue="{analytics>/mediumPercentage}%"
                                    state="Warning"/>

                            </HBox>


                            <HBox
                                alignItems="Center"
                                class="sapUiSmallMarginBottom">

                                <VBox width="120px">

                                    <Text text="HIGH"/>

                                    <Text
                                        text="{dashboard>/highRisk} vendors"/>

                                </VBox>

                                <ProgressIndicator
                                    width="100%"
                                    percentValue="{analytics>/highPercentage}"
                                    displayValue="{analytics>/highPercentage}%"
                                    state="Error"/>

                            </HBox>


                            <HBox
                                alignItems="Center"
                                class="sapUiSmallMarginBottom">

                                <VBox width="120px">

                                    <Text text="CRITICAL"/>

                                    <Text
                                        text="{dashboard>/criticalRisk} vendors"/>

                                </VBox>

                                <ProgressIndicator
                                    width="100%"
                                    percentValue="{analytics>/criticalPercentage}"
                                    displayValue="{analytics>/criticalPercentage}%"
                                    state="Error"/>

                            </HBox>

                        </VBox>

                    </Panel>


                    <!-- =========================================================
     DELIVERY ANALYTICS
     ========================================================= -->

<Panel
    headerText="Delivery Analytics"
    expandable="true"
    expanded="true"
    class="sapUiMediumMarginTop">

    <VBox class="sapUiSmallMargin">

        <!-- DELIVERY KPI SUMMARY -->

        <HBox
            justifyContent="SpaceAround"
            wrap="Wrap">

            <VBox class="kpiCard">
                <Text text="Total Deliveries"/>
                <ObjectNumber
                    number="{deliveryAnalytics>/totalDeliveries}"
                    unit="Deliveries"/>
            </VBox>

            <VBox class="kpiCard">
                <Text text="Delivered"/>
                <ObjectNumber
                    number="{deliveryAnalytics>/deliveredDeliveries}"
                    unit="Deliveries"
                    state="Success"/>
            </VBox>

            <VBox class="kpiCard">
                <Text text="Pending"/>
                <ObjectNumber
                    number="{deliveryAnalytics>/pendingDeliveries}"
                    unit="Deliveries"
                    state="Warning"/>
            </VBox>

            <VBox class="kpiCard">
                <Text text="Delayed"/>
                <ObjectNumber
                    number="{deliveryAnalytics>/delayedDeliveries}"
                    unit="Deliveries"
                    state="Error"/>
            </VBox>

            <VBox class="kpiCard">
                <Text text="Total Delay Days"/>
                <ObjectNumber
                    number="{deliveryAnalytics>/totalDelayDays}"
                    unit="Days"
                    state="Error"/>
            </VBox>

        </HBox>


        <!-- DELIVERY DETAILS TABLE -->

        <Table
            id="deliveryAnalyticsTable"
            class="sapUiSmallMarginTop"
            items="{deliveryAnalytics>/DeliveryAnlySet}"
            growing="true"
            growingThreshold="10"
            noDataText="No delivery analytics data available.">

            <headerToolbar>

                <Toolbar>

                    <Title
                        text="Delivery Details"
                        level="H4"/>

                    <ToolbarSpacer/>

                    <Button
                        text="Refresh Delivery Analytics"
                        icon="sap-icon://refresh"
                        press=".loadDeliveryAnalytics"/>

                </Toolbar>

            </headerToolbar>


            <columns>

                <Column>
                    <Text text="Delivery ID"/>
                </Column>

                <Column>
                    <Text text="PO ID"/>
                </Column>

                <Column>
                    <Text text="Item No"/>
                </Column>

                <Column>
                    <Text text="Vendor ID"/>
                </Column>

                <Column>
                    <Text text="Vendor Name"/>
                </Column>

                <Column>
                    <Text text="Category"/>
                </Column>

                <Column>
                    <Text text="Expected Date"/>
                </Column>

                <Column>
                    <Text text="Delivery Date"/>
                </Column>

                <Column>
                    <Text text="Quantity"/>
                </Column>

                <Column>
                    <Text text="Delay Days"/>
                </Column>

                <Column>
                    <Text text="Status"/>
                </Column>

            </columns>


            <items>

                <ColumnListItem>

                    <cells>

                        <Text
                            text="{deliveryAnalytics>DeliveryId}"/>

                        <Text
                            text="{deliveryAnalytics>PurchaseOrderId}"/>

                        <Text
                            text="{deliveryAnalytics>ItemNo}"/>

                        <Text
                            text="{deliveryAnalytics>VendorId}"/>

                        <Text
                            text="{deliveryAnalytics>VendorName}"/>

                        <Text
                            text="{deliveryAnalytics>VendorCategory}"/>

                        <Text
                            text="{deliveryAnalytics>ExpectedDate}"/>

                        <Text
                            text="{deliveryAnalytics>DeliveryDate}"/>

                        <ObjectNumber
                            number="{deliveryAnalytics>DeliveredQuantity}"/>

                        <ObjectNumber
                            number="{deliveryAnalytics>DelayDays}"/>

                        <ObjectStatus
                            text="{deliveryAnalytics>DeliveryStatus}"
                            state="{
                                path: 'deliveryAnalytics>DeliveryStatus',
                                formatter: '.formatDeliveryStatusState'
                            }"/>

                    </cells>

                </ColumnListItem>

            </items>

        </Table>

    </VBox>

</Panel>
                    <!-- =========================================================
     PURCHASE ORDER ANALYTICS
     ========================================================= -->

<Panel
    headerText="Purchase Order Analytics"
    expandable="true"
    expanded="true"
    class="sapUiMediumMarginTop">

    <VBox class="sapUiSmallMargin">

        <!-- PO KPI SUMMARY -->

        <HBox
            justifyContent="SpaceAround"
            wrap="Wrap">

            <VBox class="kpiCard">
                <Text text="Total POs"/>
                <ObjectNumber
                    number="{poAnalytics>/totalPOs}"
                    unit="Orders"/>
            </VBox>

            <VBox class="kpiCard">
                <Text text="Total PO Amount"/>
                <ObjectNumber
                    number="{poAnalytics>/totalAmount}"
                    unit="USD"/>
            </VBox>

            <VBox class="kpiCard">
                <Text text="Delivered POs"/>
                <ObjectNumber
                    number="{poAnalytics>/deliveredPOs}"
                    unit="Orders"
                    state="Success"/>
            </VBox>

            <VBox class="kpiCard">
                <Text text="Delayed POs"/>
                <ObjectNumber
                    number="{poAnalytics>/delayedPOs}"
                    unit="Orders"
                    state="Error"/>
            </VBox>

        </HBox>


        <!-- PO DETAILS TABLE -->

        <Table
            id="poAnalyticsTable"
            class="sapUiSmallMarginTop"
            items="{poAnalytics>/POAnalyticsSet}"
            growing="true"
            growingThreshold="10"
            noDataText="No purchase order analytics data available.">

            <headerToolbar>

                <Toolbar>

                    <Title
                        text="Purchase Order Details"
                        level="H4"/>

                    <ToolbarSpacer/>

                    <Button
                        text="Refresh PO Analytics"
                        icon="sap-icon://refresh"
                        press=".loadPOAnalytics"/>

                </Toolbar>

            </headerToolbar>


            <columns>

                <Column>
                    <Text text="PO ID"/>
                </Column>

                <Column>
                    <Text text="PR ID"/>
                </Column>

                <Column>
                    <Text text="Vendor ID"/>
                </Column>

                <Column>
                    <Text text="Vendor Name"/>
                </Column>

                <Column>
                    <Text text="Category"/>
                </Column>

                <Column>
                    <Text text="Order Date"/>
                </Column>

                <Column>
                    <Text text="Expected Date"/>
                </Column>

                <Column>
                    <Text text="Actual Date"/>
                </Column>

                <Column>
                    <Text text="Amount"/>
                </Column>

                <Column>
                    <Text text="Currency"/>
                </Column>

                <Column>
                    <Text text="Status"/>
                </Column>

            </columns>


            <items>

                <ColumnListItem>

                    <cells>

                        <Text
                            text="{poAnalytics>PurchaseOrderId}"/>

                        <Text
                            text="{poAnalytics>PurchaseRequisitionId}"/>

                        <Text
                            text="{poAnalytics>VendorId}"/>

                        <Text
                            text="{poAnalytics>VendorName}"/>

                        <Text
                            text="{poAnalytics>VendorCategory}"/>

                        <Text
                            text="{poAnalytics>OrderDate}"/>

                        <Text
                            text="{poAnalytics>ExpectedDate}"/>

                        <Text
                            text="{poAnalytics>ActualDate}"/>

                        <ObjectNumber
                            number="{poAnalytics>TotalAmount}"/>

                        <Text
                            text="{poAnalytics>Currency}"/>

                        <ObjectStatus
                            text="{poAnalytics>POStatus}"
                            state="{
                                path: 'poAnalytics>POStatus',
                                formatter: '.formatPOStatusState'
                            }"/>

                    </cells>

                </ColumnListItem>

            </items>

        </Table>

    </VBox>

</Panel>

<!-- =========================================================
     PROCUREMENT OVERVIEW
     ========================================================= -->

<Panel
    headerText="Procurement Overview"
    expandable="true"
    expanded="true"
    class="sapUiMediumMarginTop">

    <VBox class="sapUiSmallMargin">

        <!-- PROCUREMENT KPI SUMMARY -->

        <HBox
            justifyContent="SpaceAround"
            wrap="Wrap">

            <VBox class="kpiCard">
                <Text text="Total POs"/>
                <ObjectNumber
                    number="{procOverview>/totalPOs}"
                    unit="Orders"/>
            </VBox>

            <VBox class="kpiCard">
                <Text text="Total PO Amount"/>
                <ObjectNumber
                    number="{procOverview>/totalAmount}"
                    unit="USD"/>
            </VBox>

            <VBox class="kpiCard">
